# GreenGram Runtime Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env for local development and fill in real values.
# NEVER commit .env — it is excluded by .gitignore.
#
# On cloud platforms (Render, Railway, DigitalOcean App Platform):
#   Set these directly in the environment variable dashboard.
#   .env files are not used on those platforms.
# ─────────────────────────────────────────────────────────────────────────────

# ── Meta / WhatsApp Cloud API ─────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
WHATSAPP_API_URL=https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_API_TOKEN=your_meta_access_token_here
WHATSAPP_CATALOG_ID=your_catalog_id_here

# Found in: Meta Developer Console → Your App → Settings → Basic → App Secret
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Set to false ONLY if WHATSAPP_APP_SECRET is unavailable during initial rollout.
# Must be restored to true once the secret is confirmed and verified.
WHATSAPP_SIGNATURE_VERIFICATION_ENABLED=true

# ── Operational Phone Numbers (format: 91XXXXXXXXXX — no + or spaces) ─────────
WAREHOUSE_PHONE_NUMBER=91XXXXXXXXXX
FALLBACK_MANAGER_PHONE=91XXXXXXXXXX
# Comma-separated, no spaces between commas
AUTHORIZED_RIDER_NUMBERS=91XXXXXXXXXX,91XXXXXXXXXX

# ── PostgreSQL Database ────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/deliverydb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# ── Admin REST API ─────────────────────────────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRATION_MS=

# ── CORS — Admin React Dashboard ──────────────────────────────────────────────
# Development origin (default when env var is not set): http://localhost:5173
# To allow multiple origins, use comma-separated values:
#   ADMIN_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://admin.yourdomain.com
ADMIN_CORS_ALLOWED_ORIGINS=http://localhost:5173
